{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "env": {
    "QT_QPA_PLATFORM": "offscreen"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_on_edit.py\"; [ -f \"$f\" ] || exit 0; uv run --project \"$CLAUDE_PROJECT_DIR\" python \"$f\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
